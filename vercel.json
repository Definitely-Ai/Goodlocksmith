                }
            ],
            "destination": "/domains/lillington.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "www.lillingtonlocksmith.com"
                }
            ],
            "destination": "/domains/lillington.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
