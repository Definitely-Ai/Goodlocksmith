{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "goodlocksmith.vercel.app"
                }
            ],
            "destination": "https://www.goodlocksmith.com/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "angierlocksmith.com"
                }
            ],
            "destination": "/domains/angier.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "www.angierlocksmith.com"
                }
            ],
            "destination": "/domains/angier.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "dunnlocksmith.com"
                }
            ],
            "destination": "/domains/dunn.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "www.dunnlocksmith.com"
                }
            ],
            "destination": "/domains/dunn.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "harnettcountylocksmith.com"
                }
            ],
            "destination": "/domains/harnett.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "www.harnettcountylocksmith.com"
                }
            ],
            "destination": "/domains/harnett.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "wakecountylocksmith.com"
                }
            ],
            "destination": "/domains/wake.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "www.wakecountylocksmith.com"
                }
            ],
            "destination": "/domains/wake.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "locksmithfuquay.com"
                }
            ],
            "destination": "/domains/fuquay.html"
        },
        {
            "source": "/",
